node_modules/
dist/
.vite/
__pycache__/
# step2glb.mjs が生成する変換成果物(再生成可能・巨大)。手置きアセットは別途残す。
public/*.glb
*.glb

# 動作確認用に別リポジトリ(NHK-K2026/cad)から複製した URDF 一式。
# cad 側で `python urdf/tr_urdf.py` と `python scripts/export_meshes.py` を
# 走らせれば作り直せる（8.9MB あるので追跡しない）。
# ⚠ 複製は古くなる。いまは mounts.json で元フォルダーを直接配信できる（README 参照）。
public/urdf/

# 各自の環境の絶対パスなので共有しない。README の「外部フォルダーを URL で開く」参照。
mounts.json

# mounts.json のフォルダーを本番ビルド用に複製したもの（`npm run build` が作る）。
# 元は別リポジトリの生成物なので追跡しない。
public/local/
